---
interface Props {
  eyebrow: string;
  id: string;
}
const { eyebrow, id } = Astro.props;
---

<header class="section-head reveal">
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="headline" id={id}><slot /></h2>
  {Astro.slots.has('body') && <p class="body-lg"><slot name="body" /></p>}
</header>

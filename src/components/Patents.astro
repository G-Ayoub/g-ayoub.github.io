---
import SectionHead from './SectionHead.astro';
import { patents } from '@/data/patents';

const dateFormat = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const issued = patents.filter((p) => p.status === 'issued').length;
---

<section class="section" id="patents" aria-labelledby="patents-title">
  <SectionHead eyebrow="Patents" id="patents-title">
    Ideas, on the record.
    <Fragment slot="body">
      Co-inventor on {patents.length} patents filed with INAPI (Algeria), {issued} of them issued — spanning child safety,
      telecom hardware and radio detection.
    </Fragment>
  </SectionHead>

  <ol class="patents reveal" role="list">
    {
      patents.map((p) => (
        <li class="patent">
          <time datetime={p.date}>{dateFormat.format(new Date(p.date))}</time>
          <div>
            <h3>{p.title}</h3>
            <p>{p.number} · {p.office}</p>
          </div>
          <span class={`badge badge-${p.status}`}>{p.status === 'issued' ? 'Issued' : 'Filed'}</span>
        </li>
      ))
    }
  </ol>
</section>

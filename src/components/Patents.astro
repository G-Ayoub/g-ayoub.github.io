---
import SectionHead from './SectionHead.astro';
import { patents } from '@/data/patents';

const dateFormat = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<section class="section" id="patents" aria-labelledby="patents-title">
  <SectionHead eyebrow="Patents" id="patents-title">
    Ideas, on the record.
    <Fragment slot="body">
      Four inventions filed with INAPI (Algeria), spanning child safety, telecom hardware and radio detection.
    </Fragment>
  </SectionHead>

  <ol class="patents reveal" role="list">
    {
      patents.map((p) => (
        <li class="patent">
          <time datetime={p.filed}>{dateFormat.format(new Date(p.filed))}</time>
          <div>
            <h3>{p.title}</h3>
            <p>{p.number} · {p.office}</p>
          </div>
          <span class="badge">{p.status}</span>
        </li>
      ))
    }
  </ol>
</section>
